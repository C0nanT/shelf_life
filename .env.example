# Copy to `.env` (git-ignored) and fill in. Never commit `.env`.

# Same bot and chat as the site alerts.
# Bot token from @BotFather, e.g. 123456789:AAE...
TELEGRAM_BOT_TOKEN=
# Numeric chat id (negative for groups), e.g. 123456789
TELEGRAM_CHAT_ID=

# Optional overrides, read by docker compose itself (defaults shown).
# Host port on 127.0.0.1 for the page:
# SHELF_LIFE_PORT=25080
# Host folder for the daily backups; it must exist before `docker compose up`:
# SHELF_LIFE_BACKUP_HOST_DIR=/home/conan/Desktop/backups/shelf_life
# Container user and group; use your `id -u` and `id -g` so backups are owned by you:
# SHELF_LIFE_UID=1000
# SHELF_LIFE_GID=1000
